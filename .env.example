# ── Banco de dados ─────────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=wedding_gifts

# ── Servidor ────────────────────────────────────────────────────────────────────
PORT=3001

# ── CORS ────────────────────────────────────────────────────────────────────────
# Origens permitidas, separadas por vírgula. Deixar vazio desabilita CORS por completo.
# Exemplo: https://meusite.com,https://www.meusite.com
CORS_ORIGIN=http://localhost:3000

# ── Gateway de pagamento ────────────────────────────────────────────────────────
# Valores: mock | asaas
PAYMENT_PROVIDER=mock

# ── Asaas (obrigatório quando PAYMENT_PROVIDER=asaas) ──────────────────────────
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_AUTH_TOKEN=
